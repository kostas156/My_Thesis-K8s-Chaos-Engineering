apiVersion: chaos-mesh.org/v1alpha1
kind: Workflow
metadata: 
  name: easy-workflow 
  namespace: chaos-mesh 
spec: 
  entry: main 
  templates: 
    - name: main 
      templateType: Serial 
      deadline: 35m 
      children: 
        - warmup 
        - network-failure-phase 
        - recovery-intermediate 
        - cpu-stress-phase 
        - recovery-final 
 
    # 1. Warmup 
    - name: warmup 
      templateType: Suspend 
      deadline: 5m

 
    # ------------------------------ 
    # ΦΑΣΗ Α: Network & Pod Failure 
    # ------------------------------ 
    - name: network-failure-phase 
      templateType: Parallel 
      deadline: 7m 
      children: 
        - mild-network-delay-frontend 
        - mild-network-loss-frontend 
        - mild-pod-failure-adservice 
 
    # Chaos Definitions Φάση Α 
    - name: mild-network-delay-frontend 
      templateType: NetworkChaos 
      deadline: 7m 
      networkChaos: 
        action: delay 
        mode: all 
        direction: to 
        selector: 
          namespaces: 
            - online-boutique 
          labelSelectors: 
            app: frontend 
        delay: 
          latency: "150ms" 
          correlation: "25" 
          jitter: "50ms" 
 
    - name: mild-network-loss-frontend 
	templateType: NetworkChaos 
	deadline: 7m 
	networkChaos: 
		action: loss 
		mode: all 
		direction: to 
		selector: 
		  namespaces: 
		    - online-boutique 
		  labelSelectors: 
		    app: frontend 
		loss: 
		  loss: "1" 
		  correlation: "0" 
 
    - name: mild-pod-failure-adservice 
    templateType: PodChaos 
      deadline: 7m 
      podChaos: 
        action: pod-failure 
        mode: one 
        selector: 
          namespaces: 
            - online-boutique 
          labelSelectors: 
            app: adservice 
 
    # 2. Ενδιάμεση Ανάκαμψη 
    - name: recovery-intermediate 
      templateType: Suspend 
      deadline: 5m 
 
    # ------------------ 
    # ΦΑΣΗ Β: CPU Stress 
    # ------------------ 
    - name: cpu-stress-phase 
      templateType: Parallel 
      deadline: 7m 
      children: 
        - mild-cpu-stress-frontend 
        - mild-cpu-stress-checkout 
 
    # Chaos Definitions για Φάση Β 
    - name: mild-cpu-stress-frontend 
      templateType: StressChaos 
      deadline: 7m 
      stressChaos: 
        mode: all 
        selector: 
          namespaces: 
            - online-boutique 
          labelSelectors: 
            app: frontend 
        stressors: 
          cpu: 
            workers: 2 
            load: 70 
 
    - name: mild-cpu-stress-checkout 
      templateType: StressChaos 
      deadline: 7m 
      stressChaos: 
        mode: all 
        selector: 
          namespaces: 
            - online-boutique 
          labelSelectors: 
            app: checkoutservice 
        stressors: 
          cpu: 
            workers : 2 
            load : 70 
 
    # 3. Τελική Ανάκαμψη 
    - name: recovery-final 
      templateType: Suspend 
      deadline: 5m